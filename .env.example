# Admiral Server Configuration
# Copy this file to .env and fill in the values

# Database
ADMIRAL_DATABASE_URL=postgres://admiral:admiral@localhost:5432/admiral

# JWT Keys (generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048)
ADMIRAL_JWT_PRIVATE_KEY_PATH=./keys/private.pem
ADMIRAL_JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token Encryption (generate with: openssl rand -hex 32)
ADMIRAL_TOKEN_ENCRYPTION_KEY=

# Bilibili OAuth (4th doc: APP_ID / APP_SECRET)
ADMIRAL_BILI_APP_ID=YOUR_BILIBILI_APP_ID
ADMIRAL_BILI_APP_SECRET=REDACTED_SECRET
# B 站 OAuth 回调地址，必须 HTTPS。本地无法配置 HTTPS，需部署到服务器后改为 https://你的域名/api/v1/oauth/bilibili/callback
# 详见 docs/服务器部署与OAuth联调.md
ADMIRAL_BILI_CALLBACK_URL=https://localhost:8080/api/v1/oauth/bilibili/callback

# LLM（联调阶段仅 DeepSeek deepseek-chat，其他厂商已屏蔽）
ADMIRAL_DEEPSEEK_API_KEY=
# 以下留空即可，联调时不使用
# ADMIRAL_LLM_DEFAULT_PROVIDER=deepseek
# ADMIRAL_DOUBAO_API_KEY=
# ADMIRAL_OPENAI_API_KEY=
# ADMIRAL_GEMINI_API_KEY=

# Server
ADMIRAL_SERVER_HOST=0.0.0.0
ADMIRAL_SERVER_PORT=8080
ADMIRAL_LOG_LEVEL=info
