{
  "productName": "Admiral",
  "version": "0.1.0",
  "identifier": "com.admiral.client",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "sh ./dev-ui.sh",
    "beforeBuildCommand": "sh ./build-ui.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Admiral",
        "width": 1440,
        "height": 860,
        "minWidth": 1240,
        "minHeight": 720,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": { "active": false }
}
